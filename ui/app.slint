import "../fonts/SpaceGrotesk-Regular.ttf";
import "../fonts/SpaceGrotesk-Medium.ttf";
import "../fonts/SpaceGrotesk-Bold.ttf";

export struct Member { name: string, initial: string, tint: color, muted: bool, speaking: bool }
export struct Seat { name: string, initial: string, tint: color, muted: bool, speaking: bool, id: int, quiet: bool, mine: bool, gain: float }
export struct Band { seats: [Seat] }
export struct Channel { name: string, members: [Member] }
export struct Line { author: string, body: string, mine: bool }

global Theme {
    // Charcoal shell. Lime is the only sharp color, and it is reserved for controls.
    out property <color> bg: #0b0c0e;
    out property <color> surface: #17191d;
    out property <color> elevated: #23262c;
    out property <color> ink: #e7e8eb;
    out property <color> muted: #8d9199;
    out property <color> signal: #D9F078;
    out property <color> danger: #e08b92;
    out property <color> frame: #4a4e57;
    out property <string> sans: "Space Grotesk";
}

// The app icon: a lowercase r on the torn tile. The word beside it stays the full name.
component Mark inherits Rectangle {
    width: 24px;
    height: 24px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: transparent;

    Path {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        viewbox-width: 300;
        viewbox-height: 300;
        commands: "M 6 48 C 6 18 24 6 54 6 L 294 6 L 294 246 L 274 262 L 290 278 L 266 294 L 6 294 L 6 48 Z";
        fill: Theme.bg;
        stroke: Theme.frame;
        stroke-width: 1px;
    }

    Path {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        viewbox-width: 300;
        viewbox-height: 300;
        commands: "M 100 228 L 100 86 L 128 86 C 170 86 188 98 188 116 L 188 144 L 128 144 L 128 228 Z";
        fill: Theme.ink;
    }
}

component Wordmark inherits HorizontalLayout {
    spacing: 8px;
    alignment: center;
    horizontal-stretch: 0;
    Mark {}
    Text {
        text: "ryme";
        color: Theme.ink;
        font-family: Theme.sans;
        font-size: 16px;
        font-weight: 700;
        letter-spacing: 0.4px;
        vertical-alignment: center;
    }
}

// A small four-point sparkle. Used while Ryme is connecting.
component Spark inherits Rectangle {
    in property <color> hue: Theme.ink;
    in property <bool> live: false;
    in property <bool> invert: false;
    in property <float> strength: 1;
    width: 10px;
    height: 10px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: transparent;

    property <bool> bright: true;
    Timer {
        interval: 760ms;
        running: root.live;
        triggered => { root.bright = !root.bright; }
    }

    property <bool> hot: root.invert ? !root.bright : root.bright;
    property <float> shown: root.live ? (root.hot ? root.strength : root.strength * 0.4) : root.strength;
    animate shown { duration: 700ms; easing: ease-in-out; }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 12 0.1 L 14.8 9.2 L 23.9 12 L 14.8 14.8 L 12 23.9 L 9.2 14.8 L 0.1 12 L 9.2 9.2 Z";
        fill: root.hue;
        opacity: 0.22 * root.shown;
    }

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 12 3.5 L 14 10 L 20.5 12 L 14 14 L 12 20.5 L 10 14 L 3.5 12 L 10 10 Z";
        fill: root.hue;
        opacity: root.shown;
    }
}

component Avatar inherits Rectangle {
    in property <string> label;
    in property <color> tint;
    in property <bool> speaking;
    in property <bool> muted;
    width: 46px;
    height: 46px;
    background: transparent;

    // A second ring, in this person's own color, with a gap. Lime stays on controls.
    ring := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 23px;
        border-width: root.speaking ? 2.5px : 0px;
        border-color: root.tint;
        animate border-width { duration: 160ms; easing: ease-out; }
    }

    disc := Rectangle {
        width: 36px;
        height: 36px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 18px;
        background: root.speaking ? root.tint.with-alpha(0.4) : Theme.surface;
        border-width: 1px;
        // Muted stays fully drawn, in the quiet ink. Fading the disc made the person vanish.
        border-color: root.muted ? Theme.frame : root.tint;
        animate background, border-color { duration: 160ms; easing: ease-out; }
        Text {
            width: 100%;
            height: 100%;
            text: root.label;
            color: root.muted ? Theme.muted : root.tint;
            font-family: Theme.sans;
            font-size: 15px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Same stroke as the card rim, held in from the edges so the tear stays the outline.
component Hairline inherits Rectangle {
    height: 1px;
    background: transparent;
    Rectangle {
        x: 18px;
        y: 0px;
        width: parent.width - 36px;
        height: 1px;
        background: Theme.frame.with-alpha(0.85);
    }
}

component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> value;
    callback submitted();
    height: 36px;
    border-radius: 10px;
    background: Theme.surface;
    border-width: 1px;
    border-color: edit.has-focus ? Theme.signal : Theme.frame;
    animate border-color { duration: 120ms; }

    if root.value == "" : Text {
        x: 12px;
        width: parent.width - 24px;
        height: 100%;
        text: root.placeholder;
        color: Theme.muted;
        font-family: Theme.sans;
        font-size: 14px;
        vertical-alignment: center;
    }

        holder := Rectangle {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: 100%;
        clip: true;
        background: transparent;

        edit := TextInput {
            property <length> computed-x: 0px;
            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
            y: 0px;
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            height: 100%;
            vertical-alignment: center;
            text <=> root.value;
            single-line: true;
            color: Theme.ink;
            font-family: Theme.sans;
            font-size: 14px;
            selection-background-color: Theme.signal;
            selection-foreground-color: Theme.bg;
            cursor-position-changed(cursor-position) => {
                if (cursor-position.x + self.computed-x < 2px) {
                    self.computed-x = -cursor-position.x + 2px;
                } else if (cursor-position.x + self.computed-x > parent.width - 2px - self.text-cursor-width) {
                    self.computed-x = parent.width - cursor-position.x - 2px - self.text-cursor-width;
                }
            }
            key-pressed(event) => {
                if (event.text == "\n") {
                    root.submitted();
                    return accept;
                }
                reject
            }
        }
    }
}

component Switch inherits Rectangle {
    in-out property <bool> on;
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: root.on ? Theme.signal : Theme.surface;
    border-width: 1px;
    border-color: root.on ? Theme.signal : Theme.frame;
    animate background, border-color { duration: 140ms; easing: ease-out; }
    Rectangle {
        x: root.on ? 18px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.on ? Theme.bg : Theme.muted;
        animate x { duration: 140ms; easing: ease-out; }
    }
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.on = !root.on; }
    }
}

component Pill inherits Rectangle {
    in property <string> label: "";
    in property <string> glyph: ""; // "mic", "speaker", or a word via label
    in property <bool> active;
    in property <color> hue: Theme.signal;
    in property <bool> busy: false;
    // A short word stays 88px. A sentence ("Check for update") needs the wider capsule.
    in property <bool> wide: false;
    callback clicked;
    // Icon controls are circles. A word ("Leave") stays a short capsule.
    // Neither stretches, so the torn corner keeps its empty ground.
    height: 38px;
    min-width: root.glyph == "" ? (root.wide ? 168px : 88px) : 38px;
    max-width: root.glyph == "" ? (root.wide ? 168px : 88px) : 38px;
    horizontal-stretch: 0;
    border-radius: 19px;
    background: active ? hue : (ta.has-hover ? hue.with-alpha(0.14) : transparent);
    border-width: 1px;
    border-color: active ? hue : hue.with-alpha(ta.has-hover ? 1.0 : 0.5);
    animate background, border-color { duration: 160ms; easing: ease-out; }
    property <color> mark: root.active ? Theme.bg : (root.hue == Theme.danger ? Theme.danger : Theme.ink);
    animate mark { duration: 160ms; }

    if root.glyph == "" && !root.busy : Text {
        width: 100%;
        height: 100%;
        text: root.label;
        overflow: elide;
        color: root.mark;
        font-family: Theme.sans;
        font-size: 14px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.busy : Spark {
        width: 9px;
        height: 9px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        hue: Theme.signal;
        live: true;
    }

    if root.glyph != "" : icons := Rectangle {
        width: 100%;
        height: 100%;
        property <float> off: root.active ? 1 : 0;
        animate off { duration: 180ms; easing: ease-in-out; }

        if root.glyph == "mic" : Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M 9.4 7.1 C 9.4 5.1 10.4 3.5 12 3.5 C 13.6 3.5 14.6 5.1 14.6 7.1 L 14.6 11.4 C 14.6 13.5 13.5 14.9 12 14.9 C 10.5 14.9 9.4 13.5 9.4 11.4 Z M 7 11.3 C 7 15.5 9.1 17.8 12 17.8 C 14.9 17.8 17 15.5 17 11.3 M 12 17.8 L 12 20.6 M 9.3 20.6 L 14.7 20.6";
            stroke: root.mark;
            stroke-width: 1.6px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
        if root.glyph == "mic" : Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M 4.8 4.8 L 19.2 19.2";
            stroke: root.mark;
            stroke-width: 1.6px;
            stroke-line-cap: round;
            opacity: icons.off;
        }
        if root.glyph == "speaker" : Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M 4.8 9.4 L 4.8 14.6 L 8.2 14.6 L 12.5 18.4 L 12.5 5.6 L 8.2 9.4 Z";
            stroke: root.mark;
            stroke-width: 1.6px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
        if root.glyph == "speaker" : Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M 15.3 9.5 C 16.5 10.4 17.1 11.2 17.1 12 C 17.1 12.8 16.5 13.6 15.3 14.5 M 17.3 7.3 C 19.3 8.8 20.3 10.4 20.3 12 C 20.3 13.6 19.3 15.2 17.3 16.7";
            stroke: root.mark;
            stroke-width: 1.6px;
            stroke-line-cap: round;
            opacity: 1 - icons.off;
        }
        if root.glyph == "speaker" : Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M 15.6 9.3 L 20.2 14.7 M 20.2 9.3 L 15.6 14.7";
            stroke: root.mark;
            stroke-width: 1.6px;
            stroke-line-cap: round;
            opacity: icons.off;
        }
        if root.glyph == "chat" : Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M 5 6.5 H 16.5 C 17.8 6.5 18.5 7.4 18.5 8.6 V 13.2 C 18.5 14.4 17.8 15.3 16.5 15.3 H 10.2 L 6.4 18.2 V 15.3 H 5 C 3.8 15.3 3 14.4 3 13.2 V 8.6 C 3 7.4 3.8 6.5 5 6.5 Z";
            stroke: root.mark;
            stroke-width: 1.6px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    no-frame: true;
    background: transparent;
    title: "ryme";
    icon: @image-url("icon.svg");
    // A little taller than the wide bar, and a few pixels smaller overall.
    // src/x11_frame.rs and src/win_frame.rs clip the corners.
    // Keep the size in sync with CARD_W / CARD_H there.
    preferred-width: 384px;
    preferred-height: 290px;
    min-width: 384px;
    max-width: 384px;
    min-height: 290px;
    max-height: 290px;
    forward-focus: keys;

    callback request-close();
    callback minimize();
    callback submit-join();
    callback send-chat(string);
    callback set-mute(bool);
    callback set-deafen(bool);
    callback leave-channel();
    callback pick-channel(string);
    callback logout();
    callback set-ptt(bool);
    callback set-denoise(bool);
    callback v-key(bool);
    callback tune(float);
    callback hush(bool);
    callback confirm-yes();
    callback confirm-no();
    callback check-update();

    in-out property <int> joined: -1;
    in-out property <int> panel: 0; // 0 home, 1 channels, 2 chat, 3 settings
    in-out property <bool> muted: false;
    in-out property <bool> deafened: false;
    in-out property <bool> inside: false;
    in-out property <string> display-name: "";
    in-out property <string> invite: "";
    in-out property <string> draft: "";
    in-out property <bool> joining: false;
    in-out property <bool> reconnecting: false;
    in-out property <string> toast: "";
    in-out property <bool> toast-danger: true;
    in-out property <bool> confirming: false;
    in-out property <bool> confirm-danger: true;
    in-out property <string> update-label: "";
    in-out property <bool> update-busy: false;
    in-out property <string> update-note: "";
    in-out property <bool> update-note-danger: false;
    in-out property <string> confirm-title: "";
    in-out property <string> confirm-body: "";
    in-out property <string> confirm-accept: "";
    in-out property <bool> ptt: false;
    changed ptt => {
        root.set-ptt(root.ptt);
    }
    in-out property <bool> denoise: true;
    changed denoise => {
        root.set-denoise(root.denoise);
    }
    in-out property <[Band]> bands: [];
    in-out property <int> picked: -1;
    in-out property <string> picked-name: "";
    in-out property <float> picked-gain: 1;
    in-out property <bool> picked-quiet: false;
    changed inside => {
        if (root.inside && root.panel != 2) {
            keys.focus();
        }
    }
    changed panel => {
        if (root.inside && root.panel != 2) {
            keys.focus();
        }
    }
    in-out property <[Channel]> channels: [];
    in-out property <[Line]> lines: [];

    // "Up to date." is a confirmation, not a setting. It leaves so the page
    // settles back to the rows and the two buttons.
    Timer {
        interval: 3s;
        running: root.update-note == "Up to date.";
        triggered => { root.update-note = ""; }
    }

    keys := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == "v" || event.text == "V") {
                root.v-key(true);
                return accept;
            }
            reject
        }
        key-released(event) => {
            if (event.text == "v" || event.text == "V") {
                root.v-key(false);
                return accept;
            }
            reject
        }
    }

    // Round top-left, torn bottom-right. Keep this path in sync with src/x11_frame.rs.
    // Fill only. The rim is a separate path, drawn last, so nothing covers it.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 384;
        viewbox-height: 290;
        commands: "M 2 34 C 2 14 16 2 38 2 L 382 2 L 382 266 L 374 272 L 380 278 L 372 284 L 376 288 L 2 288 L 2 34 Z";
        fill: Theme.bg;
    }

    // Stars only — charcoal-white night, minimal, no moon.
    // Fits the clean dark design of a lightweight Teamspeak/Mumble alternative.
    Rectangle { x: 104px; y: 20px; width: 2px; height: 2px; border-radius: 1px; background: #e0e0e0; opacity: 0.45; }
    Rectangle { x: 168px; y: 30px; width: 2px; height: 2px; border-radius: 1px; background: #e0e0e0; opacity: 0.55; }
    Rectangle { x: 214px; y: 16px; width: 2px; height: 2px; border-radius: 1px; background: #e0e0e0; opacity: 0.75; }
    Rectangle { x: 246px; y: 38px; width: 2px; height: 2px; border-radius: 1px; background: #e0e0e0; opacity: 0.35; }
    Rectangle { x: 188px; y: 52px; width: 2px; height: 2px; border-radius: 1px; background: #e0e0e0; opacity: 0.28; }
    Rectangle { x: 272px; y: 58px; width: 2px; height: 2px; border-radius: 1px; background: #e0e0e0; opacity: 0.50; }
    Rectangle { x: 358px; y: 54px; width: 2px; height: 2px; border-radius: 1px; background: #e0e0e0; opacity: 0.42; }
    Rectangle { x: 352px; y: 156px; width: 2px; height: 2px; border-radius: 1px; background: #e0e0e0; opacity: 0.32; }

    VerticalLayout {
        Rectangle {
            height: 52px;
            WindowMoveArea {}
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 12px;
                padding-top: 8px;
                alignment: space-between;
                VerticalLayout {
                    alignment: center;
                    Wordmark {}
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                    alignment: center;
                    spacing: 2px;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: gear-ta.has-hover ? Theme.elevated : transparent;
                        animate background { duration: 120ms; }
                        Path {
                            x: 6px;
                            y: 6px;
                            width: 16px;
                            height: 16px;
                            viewbox-width: 16;
                            viewbox-height: 16;
                            commands: "M 1 3 L 15 3 M 1 8 L 15 8 M 1 13 L 15 13";
                            stroke: gear-ta.has-hover ? Theme.signal : Theme.muted;
                            stroke-width: 1.4px;
                            stroke-line-cap: round;
                        }
                        Rectangle { x: 9px; y: 7px; width: 4px; height: 4px; border-radius: 2px; background: gear-ta.has-hover ? Theme.signal : Theme.muted; }
                        Rectangle { x: 15px; y: 12px; width: 4px; height: 4px; border-radius: 2px; background: gear-ta.has-hover ? Theme.signal : Theme.muted; }
                        Rectangle { x: 11px; y: 17px; width: 4px; height: 4px; border-radius: 2px; background: gear-ta.has-hover ? Theme.signal : Theme.muted; }
                        if root.update-label != "": Rectangle { x: 16px; y: 4px; width: 6px; height: 6px; border-radius: 3px; background: Theme.signal; }
                        gear-ta := TouchArea { clicked => { root.panel = 3; } }
                    }
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: min-ta.has-hover ? Theme.elevated : transparent;
                        animate background { duration: 120ms; }
                        Path {
                            x: 7px;
                            y: 13px;
                            width: 14px;
                            height: 4px;
                            viewbox-width: 14;
                            viewbox-height: 4;
                            commands: "M 1 2 L 13 2";
                            stroke: min-ta.has-hover ? Theme.signal : Theme.muted;
                            stroke-width: 1.5px;
                            stroke-line-cap: round;
                        }
                        min-ta := TouchArea { clicked => { root.minimize(); } }
                    }
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: cl-ta.has-hover ? Theme.elevated : transparent;
                        animate background { duration: 120ms; }
                        Path {
                            x: 8px;
                            y: 8px;
                            width: 12px;
                            height: 12px;
                            viewbox-width: 12;
                            viewbox-height: 12;
                            commands: "M 1 1 L 11 11 M 11 1 L 1 11";
                            stroke: cl-ta.has-hover ? Theme.signal : Theme.muted;
                            stroke-width: 1.5px;
                            stroke-line-cap: round;
                        }
                        cl-ta := TouchArea { clicked => { root.request-close(); } }
                    }
                    }
                }
            }
        }

        Hairline { }

        Rectangle {
            height: 36px;
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                spacing: 2px;
                alignment: start;
                Text {
                    text: root.joined >= 0 ? root.channels[root.joined].name : "Pick a channel";
                    color: Theme.ink;
                    font-family: Theme.sans;
                    font-size: 21px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                VerticalLayout {
                    width: 28px;
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: room-ta.has-hover ? Theme.elevated : transparent;
                        animate background { duration: 120ms; }
                        Path {
                            x: 9px;
                            y: 11px;
                            width: 10px;
                            height: 6px;
                            viewbox-width: 10;
                            viewbox-height: 6;
                            commands: "M 1 1 L 5 5 L 9 1";
                            stroke: room-ta.has-hover ? Theme.signal : Theme.muted;
                            stroke-width: 1.5px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                        }
                        room-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.panel = 1; }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            padding-left: 22px;
            height: 18px;
            Text {
                text: root.reconnecting ? "Reconnecting."
                    : root.joined < 0 ? "Not in a channel"
                    : root.channels[root.joined].members.length == 0 ? "Empty"
                    : ("" + root.channels[root.joined].members.length + " in channel");
                color: Theme.muted;
                font-family: Theme.sans;
                font-size: 13px;
                vertical-alignment: center;
            }
        }

        // Avatars wrap into rows and the spare height scrolls. The level bar
        // stays put under the list, so a long room does not push it off the card.
        Rectangle {
            vertical-stretch: 1;
            min-height: 74px;
            people := Flickable {
                width: 100%;
                height: 100%;
                content-width: self.width;
                content-height: stage.preferred-height;

                stage := VerticalLayout {
                    width: parent.width;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 6px;
                    for band in root.bands : HorizontalLayout {
                        spacing: 2px;
                        alignment: start;
                        for seat in band.seats : Rectangle {
                            width: 68px;
                            height: 72px;
                            border-radius: 12px;
                            background: root.picked == seat.id ? Theme.elevated : transparent;
                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    keys.focus();
                                    if (!seat.mine) {
                                        if (root.picked == seat.id) {
                                            root.picked = -1;
                                        } else {
                                            root.picked = seat.id;
                                            root.picked-name = seat.name;
                                            root.picked-quiet = seat.quiet;
                                            root.picked-gain = seat.gain;
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                Avatar {
                                    label: seat.initial;
                                    tint: seat.tint;
                                    muted: seat.muted || seat.quiet;
                                    speaking: seat.speaking && !seat.quiet;
                                }
                                Text {
                                    width: 64px;
                                    overflow: elide;
                                    text: seat.name;
                                    color: seat.muted || seat.quiet ? Theme.muted : Theme.ink;
                                    font-family: Theme.sans;
                                    font-size: 12px;
                                    font-weight: 500;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.picked >= 0 : Rectangle {
            height: 40px;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 16px;
                spacing: 8px;
                alignment: center;
                Text {
                    text: root.picked-name;
                    width: 72px;
                    overflow: elide;
                    color: Theme.ink;
                    font-family: Theme.sans;
                    font-size: 13px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                level := Rectangle {
                    width: 128px;
                    height: 20px;
                    background: transparent;
                    Rectangle {
                        y: 8px;
                        width: 100%;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.frame;
                    }
                    Rectangle {
                        y: 8px;
                        width: parent.width * (root.picked-gain / 2);
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.signal;
                    }
                    Rectangle {
                        x: parent.width * (root.picked-gain / 2) - 6px;
                        y: 4px;
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: Theme.ink;
                    }
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                root.picked-gain = clamp(self.mouse-x / level.width * 2, 0, 2);
                                root.tune(root.picked-gain);
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.picked-gain = clamp(self.mouse-x / level.width * 2, 0, 2);
                                root.tune(root.picked-gain);
                            }
                        }
                    }
                }
                Text {
                    text: round(root.picked-gain * 100) + "%";
                    width: 36px;
                    color: Theme.muted;
                    font-family: Theme.sans;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
                Text {
                    text: root.picked-quiet ? "Muted" : "Mute";
                    color: root.picked-quiet ? Theme.danger : Theme.muted;
                    font-family: Theme.sans;
                    font-size: 12px;
                    font-weight: 500;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    width: 44px;
                    TouchArea {
                        clicked => {
                            root.picked-quiet = !root.picked-quiet;
                            root.hush(root.picked-quiet);
                        }
                    }
                }
            }
        }

        Hairline { }

        HorizontalLayout {
            padding-left: 18px;
            padding-right: 20px;
            padding-top: 12px;
            padding-bottom: 16px;
            spacing: 8px;
            alignment: start;
            Pill { glyph: "mic"; active: root.muted; clicked => { root.muted = !root.muted; root.set-mute(root.muted); } }
            Pill { glyph: "speaker"; active: root.deafened; clicked => { root.deafened = !root.deafened; root.set-deafen(root.deafened); } }
            Pill { glyph: "chat"; clicked => { root.panel = 2; } }
            Pill { label: "Leave"; hue: Theme.danger; clicked => { root.leave-channel(); } }
        }
    }

    // Full-canvas page. Slides up over the main view. The window shape still
    // clips it, so later pages get the whole card instead of a small sheet.
    // The rim is painted after this, so the slide cannot narrow the line.
    Rectangle {
        y: root.panel == 0 ? 316px : 0px;
        width: 100%;
        height: 100%;
        background: Theme.bg;
        animate y { duration: 240ms; easing: ease-out; }
        // Eat clicks on the empty canvas so they don't reach the page underneath.
        TouchArea {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            Rectangle {
                height: 56px;
                WindowMoveArea {}
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    padding-top: 8px;
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 2px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: back-ta.has-hover ? Theme.elevated : transparent;
                                animate background { duration: 120ms; }
                                Path {
                                    x: 8px;
                                    y: 8px;
                                    width: 12px;
                                    height: 12px;
                                    viewbox-width: 12;
                                    viewbox-height: 12;
                                    commands: "M 9 1 L 3 6 L 9 11";
                                    stroke: back-ta.has-hover ? Theme.signal : Theme.ink;
                                    stroke-width: 1.6px;
                                    stroke-line-cap: round;
                                    stroke-line-join: round;
                                }
                                back-ta := TouchArea { clicked => { root.panel = 0; } }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.panel == 2 ? "Chat" : root.panel == 3 ? "Settings" : "Channels";
                                color: Theme.ink;
                                font-family: Theme.sans;
                                font-size: 17px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 2px;
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: page-min.has-hover ? Theme.elevated : transparent;
                            animate background { duration: 120ms; }
                            Path {
                                x: 7px;
                                y: 13px;
                                width: 14px;
                                height: 4px;
                                viewbox-width: 14;
                                viewbox-height: 4;
                                commands: "M 1 2 L 13 2";
                                stroke: page-min.has-hover ? Theme.signal : Theme.muted;
                                stroke-width: 1.5px;
                                stroke-line-cap: round;
                            }
                            page-min := TouchArea { clicked => { root.minimize(); } }
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 14px;
                            background: page-close.has-hover ? Theme.elevated : transparent;
                            animate background { duration: 120ms; }
                            Path {
                                x: 8px;
                                y: 8px;
                                width: 12px;
                                height: 12px;
                                viewbox-width: 12;
                                viewbox-height: 12;
                                commands: "M 1 1 L 11 11 M 11 1 L 1 11";
                                stroke: page-close.has-hover ? Theme.signal : Theme.muted;
                                stroke-width: 1.5px;
                                stroke-line-cap: round;
                            }
                            page-close := TouchArea { clicked => { root.request-close(); } }
                        }
                    }
                    }
                }
            }

            Hairline { }

            if root.panel == 1 : Flickable {
                vertical-stretch: 1;
                content-width: self.width;
                content-height: channel-rows.preferred-height;
                channel-rows := VerticalLayout {
                width: parent.width;
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 8px;
                padding-bottom: 16px;
                spacing: 2px;
                for channel[ci] in root.channels : Rectangle {
                    height: 44px;
                    border-radius: 10px;
                    background: root.joined == ci ? Theme.elevated : (row.has-hover ? Theme.surface : transparent);
                    row := TouchArea { clicked => { root.pick-channel(channel.name); root.panel = 0; } }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 14px;
                        spacing: 10px;
                        alignment: space-between;
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            VerticalLayout {
                                width: 2px;
                                alignment: center;
                                Rectangle {
                                    width: 2px;
                                    height: root.joined == ci ? 14px : 0px;
                                    border-radius: 1px;
                                    background: Theme.signal;
                                }
                            }
                            Text {
                                text: channel.name;
                                color: Theme.ink;
                                font-family: Theme.sans;
                                font-size: 16px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: channel.members.length > 0 ? "" + channel.members.length : "";
                            color: Theme.muted;
                            font-family: Theme.sans;
                            font-size: 14px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                }
                }
            }

            // The body is the card under the header. The field is anchored to
            // that box, so an empty thread cannot pack the field up under the title.
            if root.panel == 2 : Rectangle {
                height: root.height - 57px;
                chat-view := Flickable {
                    width: parent.width;
                    height: parent.height - max(composer.preferred-height, 64px);
                    content-width: self.width;
                    content-height: chat-lines.preferred-height;
                    property <length> span: chat-lines.preferred-height;
                    changed span => {
                        if (self.height > 0px) {
                            self.content-y = min(0px, self.height - self.span);
                        }
                    }
                    chat-lines := VerticalLayout {
                        width: parent.width;
                        padding-left: 22px;
                        padding-right: 22px;
                        padding-top: 10px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        for line in root.lines : HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: line.author;
                                width: 72px;
                                overflow: elide;
                                color: line.mine ? Theme.ink : Theme.muted;
                                font-family: Theme.sans;
                                font-size: 13px;
                                font-weight: 500;
                            }
                            Text {
                                text: line.body;
                                horizontal-stretch: 1;
                                overflow: elide;
                                color: Theme.ink;
                                font-family: Theme.sans;
                                font-size: 14px;
                            }
                        }
                    }
                }
                composer := VerticalLayout {
                    y: parent.height - max(self.preferred-height, 64px);
                    width: parent.width;
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 12px;
                    padding-bottom: 16px;
                    Field {
                        placeholder: "Say something";
                        value <=> root.draft;
                        submitted => {
                            if (root.draft != "") {
                                root.send-chat(root.draft);
                                root.draft = "";
                            }
                        }
                    }
                }
            }

            if root.panel == 3 : VerticalLayout {
                vertical-stretch: 1;
                Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: settings-rows.preferred-height;
                    settings-rows := VerticalLayout {
                        width: parent.width;
                        padding-left: 22px;
                        padding-right: 22px;
                        padding-top: 0px;
                        padding-bottom: 4px;
                        spacing: 0px;
                        Rectangle {
                            height: 34px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "Name"; color: Theme.ink; font-family: Theme.sans; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                                Text { text: root.display-name; color: Theme.muted; font-family: Theme.sans; font-size: 14px; vertical-alignment: center; }
                            }
                        }
                        Rectangle {
                            height: 34px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "Microphone"; color: Theme.ink; font-family: Theme.sans; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                                Text { text: "Default"; color: Theme.muted; font-family: Theme.sans; font-size: 14px; vertical-alignment: center; }
                            }
                        }
                        Rectangle {
                            height: 34px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "Speakers"; color: Theme.ink; font-family: Theme.sans; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                                Text { text: "Default"; color: Theme.muted; font-family: Theme.sans; font-size: 14px; vertical-alignment: center; }
                            }
                        }
                        Rectangle {
                            height: 36px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "Push to talk"; color: Theme.ink; font-family: Theme.sans; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: center;
                                    if root.ptt : Text {
                                        text: "Hold V";
                                        color: Theme.muted;
                                        font-family: Theme.sans;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Switch { on <=> root.ptt; }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            height: 36px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "Soften noise"; color: Theme.ink; font-family: Theme.sans; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                                VerticalLayout {
                                    alignment: center;
                                    Switch { on <=> root.denoise; }
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 2px;
                    padding-bottom: 14px;
                    spacing: 8px;
                    if root.update-note != "" : Text {
                        text: root.update-note;
                        wrap: word-wrap;
                        color: root.update-note-danger ? Theme.danger : (root.update-label != "" ? Theme.signal : Theme.muted);
                        font-family: Theme.sans;
                        font-size: 13px;
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        Pill {
                            label: "Check for update";
                            wide: true;
                            hue: Theme.signal;
                            busy: root.update-busy;
                            clicked => { root.check-update(); }
                        }
                        Pill { label: "Log out"; hue: Theme.danger; clicked => { root.logout(); } }
                    }
                }
            }
        }
    }

    // First launch. Covers the card until a name and an invite are in.
    Rectangle {
        y: root.inside ? 316px : 0px;
        width: 100%;
        height: 100%;
        background: Theme.bg;
        animate y { duration: 240ms; easing: ease-out; }
        TouchArea { width: 100%; height: 100%; }

        VerticalLayout {
            Rectangle {
                height: 52px;
                WindowMoveArea {}
                HorizontalLayout {
                    padding-left: 22px;
                    padding-right: 12px;
                    padding-top: 8px;
                    alignment: space-between;
                    VerticalLayout {
                        alignment: center;
                        Wordmark {}
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 2px;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: wel-min.has-hover ? Theme.elevated : transparent;
                                animate background { duration: 120ms; }
                                Path {
                                    x: 7px; y: 13px; width: 14px; height: 4px;
                                    viewbox-width: 14; viewbox-height: 4;
                                    commands: "M 1 2 L 13 2";
                                    stroke: wel-min.has-hover ? Theme.signal : Theme.muted;
                                    stroke-width: 1.5px;
                                    stroke-line-cap: round;
                                }
                                wel-min := TouchArea { clicked => { root.minimize(); } }
                            }
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: wel-close.has-hover ? Theme.elevated : transparent;
                                animate background { duration: 120ms; }
                                Path {
                                    x: 8px; y: 8px; width: 12px; height: 12px;
                                    viewbox-width: 12; viewbox-height: 12;
                                    commands: "M 1 1 L 11 11 M 11 1 L 1 11";
                                    stroke: wel-close.has-hover ? Theme.signal : Theme.muted;
                                    stroke-width: 1.5px;
                                    stroke-line-cap: round;
                                }
                                wel-close := TouchArea { clicked => { root.request-close(); } }
                            }
                        }
                    }
                }
            }

            Hairline { }

            VerticalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 14px;
                spacing: 6px;
                Text {
                    text: "Your name";
                    color: Theme.muted;
                    font-family: Theme.sans;
                    font-size: 12px;
                    font-weight: 500;
                }
                Field {
                    placeholder: "What friends call you";
                    value <=> root.display-name;
                }
                Rectangle { height: 8px; }
                Text {
                    text: "Invite";
                    color: Theme.muted;
                    font-family: Theme.sans;
                    font-size: 12px;
                    font-weight: 500;
                }
                Field {
                    placeholder: "ryme://host:port";
                    value <=> root.invite;
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                padding-left: 22px;
                padding-bottom: 16px;
                alignment: start;
                Pill {
                    label: "Join";
                    busy: root.joining;
                    active: !root.joining && root.display-name != "" && root.invite != "";
                    clicked => {
                        if (!root.joining && root.display-name != "" && root.invite != "") {
                            root.submit-join();
                        }
                    }
                }
            }
        }
    }

    // Beside Join. The line keeps a real width from the start, so the first
    // error is text on the elevated chip instead of an empty dark one.
    toast-bubble := Rectangle {
        visible: root.toast != "";
        x: parent.width - self.width - 18px;
        y: parent.height - self.height - 16px;
        width: 224px;
        height: max(40px, copy.preferred-height + 20px);
        border-radius: 14px;
        background: Theme.elevated;
        border-width: 1px;
        border-color: root.toast-danger ? Theme.danger : Theme.frame;

        copy := Text {
            x: 12px;
            y: 10px;
            width: 200px;
            text: root.toast;
            wrap: word-wrap;
            color: root.toast-danger ? Theme.danger : Theme.ink;
            font-family: Theme.sans;
            font-size: 13px;
        }
    }

    if root.confirming : Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.bg.with-alpha(0.72);
        TouchArea { width: 100%; height: 100%; }
        Rectangle {
            x: 28px;
            y: 74px;
            width: parent.width - 56px;
            height: 156px;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.frame;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Text {
                    text: root.confirm-title;
                    color: Theme.ink;
                    font-family: Theme.sans;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: root.confirm-body;
                    wrap: word-wrap;
                    color: Theme.muted;
                    font-family: Theme.sans;
                    font-size: 13px;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Pill { label: "Cancel"; hue: Theme.muted; clicked => { root.confirm-no(); } }
                    Pill { label: root.confirm-accept; hue: root.confirm-danger ? Theme.danger : Theme.signal; clicked => { root.confirm-yes(); } }
                }
            }
        }
    }

    // 1px line on whole pixels, just inside the fill, drawn last so the
    // shape clip and the sliding page cannot shave it.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 384;
        viewbox-height: 290;
        commands: "M 3 34 C 3 15 18 4 28 4 L 381 4 L 381 265.5 L 372.48 271.89 L 378.48 277.89 L 370.48 283.89 L 373.59 287 L 3 287 Z";
        stroke: Theme.frame;
        stroke-width: 0.75px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

export component RymeTray inherits SystemTrayIcon {
    icon: @image-url("icon.svg");
    tooltip: "Ryme";
    callback show-window();
    callback quit();

    clicked => { root.show-window(); }

    Menu {
        MenuItem {
            title: "Show";
            activated => { root.show-window(); }
        }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}
